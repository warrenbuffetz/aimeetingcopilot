{
  "name": "@interview-copilot/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && electron .",
    "build": "tsc && cp src/capture.html dist/",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.14",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.interviewcopilot.desktop",
    "productName": "Interview Copilot",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "InterviewCopilot-Setup-${version}.exe"
    }
  }
}
