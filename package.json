{
  "name": "interview-copilot",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "rm -f node_modules/@interview-copilot/web/.env.local node_modules/@interview-copilot/web/.env",
    "dev": "npm run dev -w @interview-copilot/web",
    "dev:clean": "node scripts/kill-dev-ports.mjs && sleep 1 && npm run dev:clean -w @interview-copilot/web",
    "build": "npm run build -w @interview-copilot/web",
    "lint": "npm run lint -w @interview-copilot/web",
    "test": "npm run test -w @interview-copilot/web",
    "typecheck": "npm run typecheck -w @interview-copilot/web && npm run typecheck -w @interview-copilot/shared",
    "desktop:dev": "npm run dev -w @interview-copilot/desktop",
    "desktop:build": "npm run build -w @interview-copilot/desktop",
    "seed:questrade": "node scripts/seed-library.mjs data/seed/questrade-interview.json",
    "seed:questrade:full": "node scripts/seed-library.mjs data/seed/questrade-interview-full.json",
    "audit:questrade:qa": "node scripts/generate-questrade-qa-audit.mjs",
    "ensure:simplii-profile": "node scripts/ensure-simplii-profile.mjs",
    "reset:simplii-content": "node scripts/reset-simplii-profile-content.mjs",
    "reset:simplii-content:apply": "node scripts/reset-simplii-profile-content.mjs --apply",
    "export:questrade-library": "node scripts/export-questrade-library.mjs",
    "import:simplii:final": "node scripts/import-simplii-final-qa.mjs imports/simplii_final_qa.json",
    "import:simplii:final:apply": "node scripts/import-simplii-final-qa.mjs imports/simplii_final_qa.json --apply",
    "import:simplii:final:apply:embed": "node scripts/import-simplii-final-qa.mjs imports/simplii_final_qa.json --apply --embed",
    "import:experience-gap": "node scripts/import-experience-gap-qa.mjs",
    "import:experience-gap:apply": "node scripts/import-experience-gap-qa.mjs --apply",
    "import:experience-gap:apply:embed": "node scripts/import-experience-gap-qa.mjs --apply --embed",
    "validate:experience-gap": "node scripts/validate-experience-gap-handoff.mjs",
    "experience-gap:practice-overviews": "node scripts/promote-experience-gap-practice.mjs --employer-overviews-only --apply",
    "experience-gap:practice-all": "node scripts/promote-experience-gap-practice.mjs --package-all --apply",
    "audit:experience-gap-proof": "node scripts/audit-experience-gap-proof-points.mjs",
    "validate:simplii": "node scripts/validate-simplii-profile.mjs",
    "validate:profile-isolation": "node scripts/validate-profile-isolation.mjs",
    "dedupe:prepared-qa": "node scripts/archive-duplicate-prepared-qa.mjs",
    "reconcile:questrade-curated-followups": "node scripts/reconcile-questrade-curated-followups.mjs",
    "apply:questrade-curated-followups": "node scripts/apply-questrade-curated-followups.mjs --apply",
    "apply:questrade-curated-followups:dry-run": "node scripts/apply-questrade-curated-followups.mjs --dry-run",
    "embed:qa:gte": "node scripts/embed-qa-gte.mjs",
    "import:questrade:logistics": "node scripts/import-questrade-recruiter-logistics.mjs --dry-run",
    "import:questrade:logistics:apply": "node scripts/import-questrade-recruiter-logistics.mjs --apply",
    "import:questrade:logistics:apply:embed": "node scripts/import-questrade-recruiter-logistics.mjs --apply --embed",
    "import:questrade:probes": "node scripts/import-questrade-audit-probes.mjs --dry-run",
    "import:questrade:probes:apply": "node scripts/import-questrade-audit-probes.mjs --apply",
    "import:questrade:probes:apply:embed": "node scripts/import-questrade-audit-probes.mjs --apply --embed",
    "report:questrade:consistency": "node scripts/generate-questrade-content-consistency-report.mjs",
    "apply:questrade:tier2": "node scripts/apply-questrade-tier2-consistency.mjs --dry-run",
    "apply:questrade:tier2:apply": "node scripts/apply-questrade-tier2-consistency.mjs --apply",
    "apply:questrade:tier2:apply:embed": "node scripts/apply-questrade-tier2-consistency.mjs --apply --embed",
    "report:simplii:shared": "node scripts/generate-simplii-shared-content-report.mjs",
    "eval:retrieval": "npm run test -w @interview-copilot/web -- retrieval-eval",
    "seed:questrade:q48": "node scripts/seed-library.mjs data/seed/questrade-q48-q112.json",
    "seed:questrade:resume": "node scripts/seed-library.mjs data/seed/questrade-resume-deepdives.json",
    "merge:questrade:full": "node scripts/merge-questrade-full.mjs",
    "export:custom-gpt": "node scripts/export-custom-gpt-knowledge.mjs",
    "import:follow-ups": "node scripts/import-follow-ups.mjs data/seed/questrade-follow-ups.json",
    "admin:ensure": "node scripts/ensure-admin-user.mjs",
    "migrate:library": "npx tsx scripts/migrate-library-taxonomy.ts",
    "apply:56-classifications": "npx tsx scripts/apply-56-classifications.ts",
    "apply:39-review-resolutions": "npx tsx scripts/apply-39-review-resolutions.ts",
    "apply:audit-improvements": "npx tsx scripts/apply-audit-improvements.ts",
    "import:expansion-22": "npx tsx scripts/import-expansion-22.ts",
    "reconcile:followup-92": "node scripts/reconcile-followup-expansion-92.mjs",
    "import:followup-92": "npx tsx scripts/import-followup-expansion-92.ts",
    "import:followup-92:apply": "npx tsx scripts/import-followup-expansion-92.ts --apply",
    "import:sperro-five-qa": "npx tsx scripts/import-sperro-five-qa.ts",
    "import:sperro-five-qa:apply": "npx tsx scripts/import-sperro-five-qa.ts --apply",
    "apply:expansion-review": "node scripts/apply-questrade-expansion-review.mjs --apply",
    "apply:expansion-review:dry": "node scripts/apply-questrade-expansion-review.mjs --dry-run",
    "whisper:server": ".venv-whisper/bin/python3 scripts/mac-whisper-server.py"
  }
}
